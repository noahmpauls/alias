{
  "compilerOptions": {
    "noEmit": true,
    "preserveWatchOutput": true,
    "pretty": true,

    "strict": true,
    "skipLibCheck": true,

    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // recommended for esbuild
    "esModuleInterop": true,
    "isolatedModules": true,

    // required for lit element
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,

    // required for existing browsers
    "useDefineForClassFields": false,

    "baseUrl": "src",
    "paths": {
      "@alias/*": ["lib/*"]
    }
  },
  "include": ["src/**/*"]
}
